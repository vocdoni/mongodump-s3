# Required
MONGO_URI=mongodb+srv://USER:PASS@cluster.example.mongodb.net/admin?retryWrites=true&w=majority&tls=true
BACKUP_PASSPHRASE=replace_with_strong_random_secret
CRON_SCHEDULE=15 3 * * *

# Primary storage target (required). The unprefixed names below are the legacy
# form and still work; PRIMARY_* wins when both are set.
SPACE_NAME=your-space-name
SPACE_ENDPOINT=https://fra1.digitaloceanspaces.com
AWS_ACCESS_KEY_ID=your_spaces_key
AWS_SECRET_ACCESS_KEY=your_spaces_secret
AWS_S3_FORCE_PATH_STYLE=false
# PRIMARY_SPACE_NAME=your-space-name
# PRIMARY_SPACE_ENDPOINT=https://fra1.digitaloceanspaces.com
# PRIMARY_AWS_ACCESS_KEY_ID=your_spaces_key
# PRIMARY_AWS_SECRET_ACCESS_KEY=your_spaces_secret
# PRIMARY_AWS_S3_FORCE_PATH_STYLE=false

# Secondary storage target (optional, any S3-compatible provider). Set all four
# or none; the same objects are uploaded to both and a failure on either fails
# the run.
# SECONDARY_SPACE_NAME=your-offsite-bucket
# SECONDARY_SPACE_ENDPOINT=https://s3.eu-central-1.wasabisys.com
# SECONDARY_AWS_ACCESS_KEY_ID=your_offsite_key
# SECONDARY_AWS_SECRET_ACCESS_KEY=your_offsite_secret
# SECONDARY_AWS_S3_FORCE_PATH_STYLE=false

# Optional
TZ=Etc/UTC
RETENTION=6
BACKUP_TIMEOUT=1800
EXPIRE_DAYS=365
EXTRA_MONGODUMP_ARGS=
MONGO_TLS_CA_FILE=
BACKUP_PASSPHRASE_FILE=
RUN_ON_START=false

# Restore-only
S3_OBJECT_KEY=
RESTORE_SOURCE=primary
RESTORE_VERIFY_CHECKSUM=true
EXTRA_MONGORESTORE_ARGS=
